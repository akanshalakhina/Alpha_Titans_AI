# Alpha Titans — Content Engine
#
# Copy to `.env` next to this file and edit. Every setting is optional: with no
# .env at all the app runs entirely inside this folder with the defaults shown.
# Real environment variables always win over this file.
#
#   cp .env.example .env

# ── server ──────────────────────────────────────────────────────────────────
# 127.0.0.1 is local-only. Use 0.0.0.0 to accept connections from the network
# (needed inside Docker, and to demo from another machine).
AT_HOST=127.0.0.1
AT_PORT=8000

# ── binaries ────────────────────────────────────────────────────────────────
# Only needed if ffmpeg/ffprobe are not on PATH. Give the full path if so.
AT_FFMPEG=ffmpeg
AT_FFPROBE=ffprobe

# ── storage ─────────────────────────────────────────────────────────────────
# Relative paths resolve against the application folder. Point these at a
# larger disk if you are building long-form cuts — renders are not small.
AT_UPLOADS_DIR=uploads
AT_OUTPUTS_DIR=outputs
AT_MUSIC_DIR=data/music
AT_FRONTEND_DIR=frontend
AT_PIPELINE_DIR=pipeline

# ── upload limits (MB) ──────────────────────────────────────────────────────
AT_MAX_CLIP_MB=2048
AT_MAX_TRACK_MB=120
AT_MAX_VOICE_MB=40

# ── CORS ────────────────────────────────────────────────────────────────────
# Leave empty for same-origin (the normal case: this server serves the UI).
# Only set this if you host the frontend somewhere else.
# AT_CORS_ORIGINS=https://titans.example.com,http://localhost:5173

# ── vision layer (optional) ─────────────────────────────────────────────────
# A real vision-capable model looks at frames from every clip and feeds what it
# sees into the Director. LEAVE AT_VISION_API_KEY UNSET and the app runs exactly
# as it does today on the rule-based Director alone - that fallback is a
# supported mode, not a degraded one.
#
# AT_VISION_API_KEY=sk-...
# AT_VISION_PROVIDER=anthropic          # anthropic (default) | openai
# AT_VISION_MODEL=claude-sonnet-4-5     # provider-appropriate default if unset
# AT_VISION_BASE_URL=https://api.anthropic.com   # self-hosted or gateway
# AT_VISION_FRAMES=4                    # frames sampled per clip (1-8)
# AT_VISION_TIMEOUT=90                  # seconds per request
# AT_VISION_MAX_CLIPS=12                # cap on clips analysed per build

# ── reasoning layer (optional) ──────────────────────────────────────────────
# The eighteen-agent layer runs with no key at all: every reasoning agent uses
# its deterministic fallback and marks the artifact degraded. Setting a key
# here is what lets those twelve agents actually reason. Check which mode you
# are in with  GET /api/v2/health  ->  "reasoning_enabled".
#
# AT_LLM_API_KEY=sk-...                 # the switch. Falls back to AT_VISION_API_KEY
# AT_LLM_PROVIDER=anthropic             # anthropic (default) | openai
# AT_LLM_MODEL=claude-sonnet-4-5        # provider-appropriate default if unset
# AT_LLM_BASE_URL=https://api.anthropic.com
# AT_LLM_TIMEOUT=60                     # seconds per request (floor of 10)

# ── research layer (optional) ───────────────────────────────────────────────
# Without a search key the Research agent still produces a report, marked
# degraded, from what the clips and the vision pass already say.
#
# AT_SEARCH_API_KEY=...                 # no key => provider falls back to `none`
# AT_SEARCH_PROVIDER=tavily             # tavily | brave | youtube | none (default: none)
# AT_SEARCH_MAX=8                       # results per query (clamped 1-20)
# AT_SEARCH_TIMEOUT=20                  # seconds per query (floor of 5)
# AT_RESEARCH_TTL=3600                  # seconds a research report stays cacheable
