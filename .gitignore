# secrets / local config — .env.example is the tracked template
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials/
secrets/
*credentials*.json
*service-account*.json
firebase*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# node
node_modules/

# build artifacts
dist/
build/

# generated state. Every one of these is written under outputs/ today, so
# these lines are belt-and-braces: a run that ever writes one elsewhere must
# not be able to commit it.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# footage in, renders out — never committed
uploads/*
outputs/*
data/music/*
!uploads/.gitkeep
!outputs/.gitkeep
!data/music/.gitkeep

# generated test output. tests/fixtures/ is NOT ignored: those clips are real
# inputs the backend suite uploads, so the tests cannot run without them.
tests/screenshots/

# editor/tooling backups. build_video.py.bak is the ONE exception — README.md
# documents it as the pre-change copy kept deliberately for diffing.
*.bak
!pipeline/build_video.py.bak

# scratch ffmpeg probe dumps and logs
test_rel.txt
*.signalstats.txt
*.log

# os
.DS_Store
Thumbs.db

# Generated by scripts/seed_synthetic_analytics.py - an isolated store of
# fabricated outcomes. Never committed: a synthetic row that reached the
# repository could later be mistaken for a real video's numbers.
data/_synthetic/
# Warehouse exports the operator drops in. Their own analytics, not ours.
data/analytics/*.csv
