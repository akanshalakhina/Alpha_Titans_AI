# /etc/alpha-titans/control.env  (mode 0600, owner alpha) - CONTROL PLANE
# No value below is real. Every infrastructure name must be filled in from
# your own project; none is guessed by the code.

AT_HOST=0.0.0.0
AT_CLOUD_ENABLED=1
AT_CLOUD_ROLE=control
# the queue: SQLite on this VM's persistent disk; back it up
AT_CLOUD_DB=/opt/alpha_titans/outputs/_cloud/queue.db

# how the worker reaches us (its ID tokens are minted for this audience)
AT_CLOUD_PUBLIC_URL=http://CONTROL_PLANE_INTERNAL_IP:8000

# the ONE worker VM this control plane may start and stop
AT_GCP_PROJECT=samriddhi-production
AT_GCP_ZONE=REPLACE-zone-a
AT_GCP_WORKER_INSTANCE=REPLACE-worker-instance-name

# Shared Drive folders (service accounts cannot own files in a My Drive)
AT_DRIVE_INPUT_FOLDER_ID=REPLACE_input_folder_id
AT_DRIVE_OUTPUT_FOLDER_ID=REPLACE_output_folder_id
AT_DRIVE_SHARED_DRIVE=1

# identity: this VM's attached service account, via the metadata server
AT_CLOUD_TOKEN_SOURCE=metadata

# browsers: a long random token (python -c "import secrets;print(secrets.token_urlsafe(32))")
AT_CLOUD_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE

# workers: Google ID tokens naming this exact service account
AT_CLOUD_WORKER_AUTH=google_id_token
AT_CLOUD_WORKER_SA_EMAIL=REPLACE-worker-sa@samriddhi-production.iam.gserviceaccount.com

# relay = chunks through this server (works by construction; the Drive
# session never reaches a browser). direct = unverified; see the ADR.
AT_CLOUD_UPLOAD_MODE=relay

# timings - set IDLE_GRACE to the MEASURED boot-to-ready time (ADR, Batching)
AT_CLOUD_IDLE_GRACE_S=180
AT_CLOUD_STARTUP_TIMEOUT_S=900
AT_CLOUD_LEASE_S=300
AT_CLOUD_HEARTBEAT_S=30
AT_CLOUD_MAX_JOB_S=5400
AT_CLOUD_MAX_ACTIVATION_S=21600
AT_CLOUD_MIN_START_INTERVAL_S=120
AT_CLOUD_MAX_STARTS_PER_HOUR=6
AT_CLOUD_MAX_ATTEMPTS=3
