# /etc/alpha-titans/worker.env  (mode 0600, owner alpha) - WORKER VM
# No value below is real.

AT_CLOUD_ROLE=worker
# the control plane, over the VPC's internal network
AT_CLOUD_PUBLIC_URL=http://CONTROL_PLANE_INTERNAL_IP:8000

AT_CLOUD_TOKEN_SOURCE=metadata
AT_CLOUD_WORKER_AUTH=google_id_token
AT_DRIVE_SHARED_DRIVE=1

# Nothing in today's pipeline uses the GPU (libx264, CPU whisper, hosted
# LLMs). Leave 0 unless NVENC is adopted - see docs/cloud/07-nvenc-proposal.md
AT_CLOUD_REQUIRE_GPU=0
AT_CLOUD_MIN_FREE_GB=20
AT_CLOUD_KEEP_MEDIA=0
AT_CLOUD_POLL_S=15

# the existing pipeline's own settings still apply (.env in the app folder):
# AT_LLM_*, AT_VISION_*, AT_SEARCH_* and AT_FFMPEG / AT_FFPROBE if not on PATH
